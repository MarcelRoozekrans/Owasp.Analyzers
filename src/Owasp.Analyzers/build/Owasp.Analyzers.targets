<Project>

  <!--
    OWASP-A03: Software Supply Chain Failures
    Runs dotnet list package --vulnerable during build and surfaces results as MSBuild warnings.
    Formerly OWASP-A06 (OWASP Top 10:2021) — the OwaspA06Enabled opt-out property is still
    honored for one major version so 1.x consumers don't silently lose their opt-out on upgrade.
  -->
  <Target Name="OwaspA03VulnerabilityCheck"
          AfterTargets="Build"
          Condition="'$(OwaspA03Enabled)' != 'false' and '$(OwaspA06Enabled)' != 'false'">

    <Exec Command="dotnet list package --vulnerable --include-transitive 2&gt;&amp;1"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          EchoOff="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OwaspA03Output" />
    </Exec>

    <Exec Command="dotnet list package --deprecated --include-transitive 2&gt;&amp;1"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          EchoOff="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_OwaspA03DeprecatedOutput" />
    </Exec>

    <ItemGroup>
      <_VulnerableLines Include="$(_OwaspA03Output.Split('%0A'))" />
      <_DeprecatedLines Include="$(_OwaspA03DeprecatedOutput.Split('%0A'))" />
    </ItemGroup>

    <Warning
      Condition="$([System.String]::Copy('%(_VulnerableLines.Identity)').Contains('has the following vulnerable packages'))"
      Text="OWASP-A03-001: Vulnerable NuGet packages detected. Run 'dotnet list package --vulnerable' for details."
      Code="OWASP-A03-001" />

    <Warning
      Condition="$([System.String]::Copy('%(_DeprecatedLines.Identity)').Contains('deprecated'))"
      Text="OWASP-A03-002: Deprecated NuGet packages detected. Run 'dotnet list package --deprecated' for details."
      Code="OWASP-A03-002" />

  </Target>

</Project>
